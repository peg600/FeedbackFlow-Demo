# Database
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Isolated Neon test branch (put real values in ignored .env.test.local, never use develop/production)
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=
# Exact direct endpoint hostname, independently verified in the Neon console
TEST_DATABASE_EXPECTED_HOST=
# Random token matching the guard initialized only on the confirmed test branch
TEST_DATABASE_GUARD_TOKEN=
TEST_BETTER_AUTH_SECRET=

# Explicit demo seed configuration (never commit real credentials)
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_SEED_CONFIRM=false

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Paddle sandbox only (never use live credentials, including on Vercel Production)
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
PADDLE_PRICE_ID_PRO=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Vercel sends this as Authorization: Bearer <secret> to the daily reconciliation job
CRON_SECRET=

# Optional email
RESEND_API_KEY=
EMAIL_FROM=
